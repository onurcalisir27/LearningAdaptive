<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 1.0 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 1.0 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1000.0"/>
      <inertia ixx="8.416667" iyy="8.416667" izz="16.66667"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="column_joint" type="fixed">
    <parent link="base_link"/>
    <child link="column_link"/>
    <origin xyz="0.0 0.0 0.75" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="column_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 1.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 1.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1000.0"/>
      <inertia ixx="8.416667" iyy="8.416667" izz="16.66667"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="pendulum_joint1" type="continuous">
    <limit effort="10.0" velocity="10.0"/>
    <parent link="column_link"/>
    <child link="pendulum_link1"/>
    <origin xyz="-0.107 0.0 0.5" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <dynamics damping="0.50" friction="0.03"/>
  </joint>

  <link name="pendulum_link1">
    <visual>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.5"/>
      </geometry>
      <material name="pendulum_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.04167" iyy="0.04167" izz="0.0001"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="pendulum_joint2" type="revolute">
    <limit effort="5.0" velocity="5.0" lower="0.0" upper="6.283" />
    <parent link="pendulum_link1"/>
    <child link="pendulum_link2"/>
    <origin xyz="0.0 0.0 -0.50" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <dynamics damping="0.50" friction="0.01"/>
  </joint>

  <link name="pendulum_link2">
    <visual>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.5"/>
      </geometry>
      <material name="pendulum_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.25" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.04167" iyy="0.04167" izz="0.0001"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <ros2_control name="pendulum_control" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="pendulum_joint1">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="pendulum_joint2">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>pendulum_joint1</joint_name>
      <joint_name>pendulum_joint2</joint_name>
      <topic>joint_states</topic>
      <update_rate>1000</update_rate>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rover_control)/config/two_link_controller.yaml</parameters>
      <ros>
        <parameter name="use_sim_time" type="bool">true</parameter>
      </ros>
    </plugin>
  </gazebo>
</robot>
