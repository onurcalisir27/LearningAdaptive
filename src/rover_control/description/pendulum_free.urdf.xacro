<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum">
  <xacro:include filename="$(find rover_control)/description/gazebo.xacro"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 1.0 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 1.0 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1000.0"/>
      <inertia ixx="8.416667" iyy="8.416667" izz="16.66667"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="column_joint" type="fixed">
    <parent link="base_link"/>
    <child link="column_link"/>
    <origin xyz="0.0 0.0 0.75" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="column_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 1.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 1.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1000.0"/>
      <inertia ixx="8.416667" iyy="8.416667" izz="16.66667"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="pendulum_joint" type="continuous">
    <!-- <limit effort="30.0" lower="-3.1415" upper="3.1415" velocity="30.0"/> -->
    <limit effort="50.0" velocity="30.0"/>
    <parent link="column_link"/>
    <child link="pendulum_link"/>
    <origin xyz="-0.1005 0.0 0.5" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <link name="pendulum_link">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.5"/>
      </geometry>
      <material name="pendulum_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.5"/>
      </geometry>
    </collision>

    <inertial>
<!-- Using an aluminium bar as the pendulum link \rho=2.7 g/cm^3-->
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="0.135"/>
      <inertia ixx="0.01125" iyy="0.01125" izz="0.0001"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <ros2_control name="pendulum_control" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="pendulum_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
